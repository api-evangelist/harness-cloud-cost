{
  "opencollection": "1.0.0",
  "info": {
    "name": "Harness Cloud Cost Management Anomalies Connectors API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Connectors",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List connectors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.harness.io/ng/api/connectors",
            "params": [
              {
                "name": "accountIdentifier",
                "value": "",
                "type": "query",
                "description": "The Harness account identifier."
              },
              {
                "name": "type",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the connectors (cloud accounts and Kubernetes clusters) used for cost ingestion."
        }
      ]
    }
  ],
  "bundled": true
}